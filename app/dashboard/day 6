<div class="table-container">
      <h2>All Reports</h2>
      <table>
        <tr>
          <th>Title</th>
          <th>Location</th>
          <th>Type</th>
          <th>Status</th>
          <th>Date</th>
        </tr>
        <tr>
          <td>Garbage on Street</td>
          <td>Pune</td>
          <td>Plastic</td>
          <td><span class="pending">Pending</span></td>
          <td>May 18, 2025</td>
        </tr>
        <tr>
          <td>Overflowing Dustbin</td>
          <td>Pune</td>
