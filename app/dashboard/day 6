  /* TABLE */
    .table-container{
      background:white;
      padding:20px;
      border-radius:15px;
      box-shadow:0 2px 8px rgba(0,0,0,0.1);
    }
    table{
      width:100%;
      border-collapse:collapse;
    }
    th,td{
      padding:15px;
      text-align:left;
      border-bottom:1px solid #ddd;
    }
    .pending{
      background:#ffe8a3;
      padding:5px 10px;
      border-radius:20px;
    }
    .resolved{
      background:#c8f7c5;
      padding:5px 10px;
      border-radius:20px;
    }
