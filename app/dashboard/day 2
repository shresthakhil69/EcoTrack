/* SIDEBAR */
    .sidebar{
      width:250px;
      height:100vh;
      background:linear-gradient(to bottom,#013220,#015c32);
      color:white;
      padding:20px;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
    }
    .logo{
      font-size:28px;
      font-weight:bold;
      margin-bottom:40px;
    }
    .menu{
      list-style:none;
      flex-grow: 1;
    }
    .menu li{
      padding:15px;
      margin:10px 0;
      border-radius:10px;
      cursor:pointer;
    }
    .menu li:hover{
      background:#0b7a43;
    }
